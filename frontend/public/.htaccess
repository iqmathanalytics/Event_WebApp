# React Router (SPA) — MilesWeb / Apache document root for bookmytickets.us
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: bookmytickets.us → www.bookmytickets.us (keep path + query)
  RewriteCond %{HTTP_HOST} ^bookmytickets\.us$ [NC]
  RewriteRule ^(.*)$ https://www.bookmytickets.us/$1 [R=301,L]

  # Force HTTPS on www (optional safety if HTTP still reaches Apache)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^www\.bookmytickets\.us$ [NC]
  RewriteRule ^(.*)$ https://www.bookmytickets.us/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Allow Seats.io designer iframes to register unload handlers (needed for Publish/draft save).
<IfModule mod_headers.c>
  Header always set Permissions-Policy "unload=*"
</IfModule>

# Cache static assets (hashed JS/CSS from Vite; branding images change rarely)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|webp|gif|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  <FilesMatch "^branding/">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
